# Optional: override the atlasarena-model-infra API URL (defaults to API_URL in
# src/config/constants/general.js). Must end in '/'. Copy to .env.local.
# NEXT_PUBLIC_ATLASARENA_API_URL=https://REPLACE_ME.execute-api.us-west-2.amazonaws.com/

# Optional: override the FOI params CSV URL (defaults to FOI_PARAMS_URL in
# src/config/constants/general.js). Must allow CORS GET from the app's origin.
# NEXT_PUBLIC_FOI_PARAMS_URL=https://REPLACE_ME/FOI_params_processed.csv
